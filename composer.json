{
    "name": "geeklab/toolbox",
    "description": "A collection of \"utility\" classes.",
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "EllisGL",
            "email": "example@example.com"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "digitickets/phpunit-errorhandler": "^4.1",
        "codeception/module-asserts": "^3.3",
        "phpstan/phpstan": "^2",
        "squizlabs/php_codesniffer": "^4"
    },
    "autoload": {
        "psr-4": {
            "GeekLab\\": "src"
        }
    },
    "scripts": {
        "test": "codecept run unit",
        "phpstan": "phpstan analyse --no-progress",
        "phpcs": "phpcs src --standard=PSR12 -n"
    }
}
